{
  "name": "fastify-route-contracts",
  "version": "0.1.0",
  "description": "A tiny Fastify route wrapper used to demonstrate executable TypeScript contracts.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ./node_modules/typescript7/lib/tsc.js -p tsconfig.build.json",
    "check": "node ./node_modules/typescript7/lib/tsc.js -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "tsx --test test/runtime.test.ts",
    "test:types": "tstyche",
    "test:types:all": "tstyche --target '>=5.4 <7.0'"
  },
  "keywords": [
    "fastify",
    "typescript",
    "type-testing",
    "tstyche"
  ],
  "peerDependencies": {
    "fastify": "^5.12.5"
  },
  "dependencies": {
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "eslint": "^9.39.5",
    "fastify": "^5.12.5",
    "neostandard": "^0.13.0",
    "tstyche": "^7.2.5",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript7": "npm:typescript@^7.0.2"
  }
}
